{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/quick-pane-main.tsx",
    "src/screenshot-selection-main.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/components/ui/**",
    "src/test/**",
    "**/index.ts",
    "src/lib/platform-strings.ts"
  ],
  "ignoreDependencies": [
    "@tauri-apps/*",
    "@radix-ui/*",
    "tailwindcss",
    "tw-animate-css",
    "react-day-picker",
    "@testing-library/*",
    "babel-plugin-react-compiler",
    "@tailwindcss/typography",
    "katex"
  ],
  "ignoreExportsUsedInFile": true
}
