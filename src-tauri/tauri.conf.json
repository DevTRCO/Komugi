{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Komugi",
  "version": "0.1.0",
  "identifier": "com.komugi.tutor",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Komugi",
        "width": 1000,
        "height": 700,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' tauri: ipc: http://ipc.localhost https://generativelanguage.googleapis.com"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Tran Consulting UG",
    "category": "Education",
    "shortDescription": "AI-powered screenshot tutor",
    "longDescription": "Komugi is a context-aware AI tutor. Take a screenshot, ask a question, and get Socratic explanations that help you understand.",
    "copyright": "Copyright © 2025 Tran Consulting UG. All rights reserved.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.3",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "Komugi.entitlements",
      "exceptionDomain": ""
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/DevTRCO/Komugi/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNkZCMjA1OTJEMjU3ODYKUldTR1Y5S1NCYkp2UXl6TzBCMmJCZ2F6MmxHb3Z1akt3YW12QmIrdUU5OVdVQW42UzN1U09vNzcK"
    }
  }
}
