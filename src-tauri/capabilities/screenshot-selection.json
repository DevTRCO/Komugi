{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "screenshot-selection-capability",
  "description": "Capability for the screenshot area selection overlay window",
  "windows": ["screenshot-selection"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
